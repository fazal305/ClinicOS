# ClinicOS environment configuration
# Copy this file to .env and fill in real values for your local environment.
# NEVER commit the real .env file.

# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (MySQL) ----
# These defaults match the docker-compose.yml service in this repo.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinicos
DB_USER=clinicos_app
DB_PASSWORD=dev_password_change_me

# ---- Auth ----
# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_only_placeholder_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=dev_only_placeholder_refresh_secret_do_not_use_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Seed / demo ----
# Password used for ALL seeded demo accounts (see database/seed). Change before any real deployment.
SEED_DEMO_PASSWORD=Demo@12345
